//│        <: 'i
//│     'i :> #Cons & {head: 'head, tail: 'tail, Cons#A = 'A} | #Cons & {head: 'head0, tail: 'tail0, Cons#A = 'A0}
//│        <: 'b & 'w & 'x
//│     'x :> #Cons & {head: 'head, tail: 'tail, Cons#A = 'A} | #Cons & {head: 'head0, tail: 'tail0, Cons#A = 'A0}
