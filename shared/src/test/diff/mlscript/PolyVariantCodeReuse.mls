//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'result0 :> 'c | 'd | #Var & {name: 'name0}
//│              <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'g1 <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {name: 'name3}
//│     'name3 <: string
//│     'k :> #Abs & {Abs#a = 'a, name: 'name, body: 'body}
//│        <: {body: 'body1} & {name: 'name4}
//│     'body :> 'c | 'd
//│           <: 'body0 & 'body1 & 'a
//│     'body1 :> 'c | 'd
//│            <: 'h1
//│     'body0 :> 'c | 'd
//│            <: 'h1
//│     'h1 :> #Num & {num: 'num1} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0} | #Num & {num: 'num0} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | 'c | 'd
//│         <: #Lambda & 'i | #Expr & 'j & ~#Lambda
//│     'j :> #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0}
//│        <: 'i1
//│     'i1 :> #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0}
//│         <: #Var & 'j1 | (#Num & 'k1 | (#Add & 'l1 | #Mul & 'm1 & ~#Add) & ~#Num) & ~#Var
//│     'm1 :> #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2}
//│         <: {rhs: 'rhs3} & {lhs: 'lhs3}
//│     'l1 :> #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1}
//│         <: {rhs: 'rhs4} & {lhs: 'lhs4}
//│     'k1 :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│         <: #Var & 'n1 | (#Add & 'c1 | (#Mul & 'e1 | #Num & 'f1 & ~#Mul) & ~#Add) & ~#Var
//│     'j1 <: #Var & 'n1 | (#Add & 'c1 | (#Mul & 'e1 | #Num & 'f1 & ~#Mul) & ~#Add) & ~#Var
//│     'f1 :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'e1 :> #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs5} & {lhs: 'lhs5}
//│     'c1 :> #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs6} & {lhs: 'lhs6}
//│     'l :> #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: 'lhs
//│     'n1 <: 'o1
//│     'o1 <: #Var & 'g1
//│     'a0 :> #Num & {num: 'num1} | 'c | 'd | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│     'lhs2 :> 'lhs7
//│           <: 'lhs3 & 'lhs5 & 'a2
//│     'lhs7 :> 'c | 'd
//│           <: 'lhs3 & 'lhs5 & 'a3
//│     'lhs5 :> 'c | 'd
//│           <: #Num & 'o | 'p & Object & ~#Num
//│     'p :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs2 :> 'rhs7
//│           <: 'rhs3 & 'rhs5 & 'a2
//│     'rhs7 :> 'c | 'd
//│           <: 'rhs3 & 'rhs5 & 'a4
//│     'rhs5 :> 'c | 'd
//│           <: #Num & 'm | 'n & Object & ~#Num
//│     'n :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs1 :> 'lhs8
//│           <: 'lhs4 & 'lhs6 & 'a1
//│     'lhs8 :> 'c | 'd
//│           <: 'lhs4 & 'lhs6 & 'a5
//│     'lhs6 :> 'c | 'd
//│           <: #Num & 's | 't & Object & ~#Num
//│     't :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs1 :> 'rhs8
//│           <: 'rhs4 & 'rhs6 & 'a1
//│     'rhs8 :> 'c | 'd
//│           <: 'rhs4 & 'rhs6 & 'a6
//│     'rhs6 :> 'c | 'd
//│           <: #Num & 'q | 'r & Object & ~#Num
//│     'r :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs :> #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│          <: 'lhs0 & 'a0
//│     'lhs0 :> #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num} | #Add & {Add#a = 'a1, lhs: 'lhs1, rhs: 'rhs1} | #Num & {num: 'num0} | #Var & {name: 'name0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│           <: 'h1
//│     'rhs :> 'c | 'd
//│          <: 'rhs0 & 'a0
//│     'rhs0 :> 'c | 'd
//│           <: 'h1
//│     'q :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num2}
//│     'rhs4 :> 'c | 'd
//│           <: 'rhs9
//│     'rhs9 :> 'c | 'd
//│           <: 'h1
//│     's :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num3}
//│     'lhs4 :> 'c | 'd
//│           <: 'lhs9
//│     'lhs9 :> 'c | 'd
//│           <: 'h1
//│     'a1 :> 'a5 | 'a6
//│     'a6 :> 'c | 'd
//│     'a5 :> 'c | 'd
//│     'm :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num4}
//│     'rhs3 :> 'c | 'd
//│           <: 'rhs10
//│     'rhs10 :> 'c | 'd
//│            <: 'h1
//│     'o :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num5}
//│     'num0 :> int
//│           <: 'num4 & 'num5 & 'num2 & 'num3 & int
//│     'num3 := int
//│     'num2 := int
//│     'num5 := int
//│     'num4 := int
//│     'num := int
//│     'lhs3 :> 'c | 'd
//│           <: 'lhs10
//│     'lhs10 :> 'c | 'd
//│            <: 'h1
//│     'a2 :> 'a3 | 'a4
//│     'a4 :> 'c | 'd
//│     'a3 :> 'c | 'd
//│     'num1 :> 1
//│           <: int
//│     'name :> string
//│           <: 'name4 & 'name2 & string
//│     'name2 :> string
//│            <: 'p1
//│     'p1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     'name4 :> string
//│            <: 'u1
//│     'u1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     't1 :> string
//│     's1 :> string
//│         <: 'v1
//│     'v1 := string
//│     'r1 :> string
//│     'q1 :> string
//│         <: 'w1
//│     'w1 := string
//│     'name0 :> string
//│            <: 'name1 & string
//│     'name1 := string
//│    = <no result>
//│      eval3, eval_lexpr, eval_lambda, eval_var, list_assoc and eq are not implemented

:ns
eval3 Nil (App { lhs = Num {num = 0}; rhs = Num {num = 0}})
//│ res: 'b
//│   where
//│     'b :> 'c | 'd
//│     'c :> 'e | 'f | 'g | 'h
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'h :> #Abs & {name: 'name, body: 'body, Abs#a = 'a}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'g :> #App & {lhs: 'lhs, rhs: 'rhs, App#a = 'a0}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'f :> 'c | 'd
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'e :> 'u | 'result
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'result :> 'c | 'd | #Var & {name: 'name0}
//│             <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'u :> #Var & {name: 'name0}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {name: 'name1}
//│     'i :> #App & {App#a = 'a1, lhs: 'lhs0, rhs: 'rhs0} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: 'v
//│     'v :> #App & {App#a = 'a1, lhs: 'lhs0, rhs: 'rhs0} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: #Var & 'w | (#App & 'x | #Abs & 'y & ~#App) & ~#Var
//│     'y :> #Abs & {Abs#a = 'a, name: 'name, body: 'body}
//│        <: {body: 'body0} & {name: 'name2}
//│     'x :> #App & {App#a = 'a1, lhs: 'lhs0, rhs: 'rhs0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│        <: {rhs: 'rhs1} & {lhs: 'lhs1}
//│     'w :> #Var & {name: 'name0}
//│        <: 'z
//│     'z :> #Var & {name: 'name0}
//│        <: #Var & 'u
//│     'lhs0 :> #Num & {num: 'num}
//│           <: 'lhs1 & 'a1
//│     'lhs1 :> #Num & {num: 'num} | #Num & {num: 'num0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2} | #Var & {name: 'name0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│           <: 'a1
//│     'a2 :> 'a4 | 'a5
//│     'a4 :> 'c | 'd
//│     'd :> 'b1 | 'c1 | 'd1 | 'e1 | 'f1 | 'g1
//│        <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'e1 :> #Num & {num: 'num1}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'c1 :> #Num & {num: 'num2}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'b1 :> 'h1 | 'result0
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'result0 :> 'c | 'd | #Var & {name: 'name0}
//│              <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'h1 <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {name: 'name3}
//│     'name3 <: string
//│     'k :> #Abs & {Abs#a = 'a, name: 'name, body: 'body}
//│        <: {body: 'body1} & {name: 'name4}
//│     'body :> 'c | 'd
//│           <: 'body0 & 'body1 & 'a
//│     'body1 :> 'c | 'd
//│            <: 'a1
//│     'body0 :> 'c | 'd
//│            <: 'a1
//│     'a1 :> #Num & {num: 'num} | #Num & {num: 'num0} | #App & {lhs: 'lhs0, rhs: 'rhs0, App#a = 'a1} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0} | #Num & {num: 'num2} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num1} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | 'c | 'd
//│         <: #Lambda & 'i | #Expr & 'j & ~#Lambda
//│     'j :> #Num & {num: 'num} | #Num & {num: 'num0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2}
//│        <: 'i1
//│     'i1 :> #Num & {num: 'num} | #Num & {num: 'num0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2}
//│         <: #Var & 'j1 | (#Num & 'k1 | (#Add & 'l1 | #Mul & 'm1 & ~#Add) & ~#Num) & ~#Var
//│     'm1 :> #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2}
//│         <: {rhs: 'rhs4} & {lhs: 'lhs4}
//│     'l1 :> #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3}
//│         <: {rhs: 'rhs5} & {lhs: 'lhs5}
//│     'k1 :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│         <: #Var & 'n1 | (#Add & 'd1 | (#Mul & 'f1 | #Num & 'g1 & ~#Mul) & ~#Add) & ~#Var
//│     'j1 <: #Var & 'n1 | (#Add & 'd1 | (#Mul & 'f1 | #Num & 'g1 & ~#Mul) & ~#Add) & ~#Var
//│     'g1 :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'f1 :> #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs6} & {lhs: 'lhs6}
//│     'd1 :> #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs7} & {lhs: 'lhs7}
//│     'l :> #Num & {num: 'num} | #Num & {num: 'num0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: 'lhs
//│     'n1 <: 'o1
//│     'o1 <: #Var & 'h1
//│     'a0 :> #Num & {num: 'num} | #Num & {num: 'num0} | 'c | 'd | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│     'lhs2 :> 'lhs8
//│           <: 'lhs4 & 'lhs6 & 'a2
//│     'lhs8 :> 'c | 'd
//│           <: 'lhs4 & 'lhs6 & 'a4
//│     'lhs6 :> 'c | 'd
//│           <: #Num & 'o | 'p & Object & ~#Num
//│     'p :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs2 :> 'rhs8
//│           <: 'rhs4 & 'rhs6 & 'a2
//│     'rhs8 :> 'c | 'd
//│           <: 'rhs4 & 'rhs6 & 'a5
//│     'a5 :> 'c | 'd
//│     'rhs6 :> 'c | 'd
//│           <: #Num & 'm | 'n & Object & ~#Num
//│     'n :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs3 :> 'lhs9
//│           <: 'lhs5 & 'lhs7 & 'a3
//│     'lhs9 :> 'c | 'd
//│           <: 'lhs5 & 'lhs7 & 'a6
//│     'lhs7 :> 'c | 'd
//│           <: #Num & 's | 't & Object & ~#Num
//│     't :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs3 :> 'rhs9
//│           <: 'rhs5 & 'rhs7 & 'a3
//│     'rhs9 :> 'c | 'd
//│           <: 'rhs5 & 'rhs7 & 'a7
//│     'rhs7 :> 'c | 'd
//│           <: #Num & 'q | 'r & Object & ~#Num
//│     'r :> #Var & {name: 'name0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs :> #Num & {num: 'num} | #Num & {num: 'num0} | #Mul & {Mul#a = 'a2, lhs: 'lhs2, rhs: 'rhs2} | #Num & {num: 'num1} | #Add & {Add#a = 'a3, lhs: 'lhs3, rhs: 'rhs3} | #Num & {num: 'num2} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│          <: 'lhs1 & 'a0
//│     'rhs :> 'c | 'd
//│          <: 'rhs1 & 'a0
//│     'q :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│        <: {num: 'num3}
//│     'rhs5 :> 'c | 'd
//│           <: 'rhs10
//│     'rhs10 :> 'c | 'd
//│            <: 'a1
//│     's :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│        <: {num: 'num4}
//│     'lhs5 :> 'c | 'd
//│           <: 'lhs10
//│     'lhs10 :> 'c | 'd
//│            <: 'a1
//│     'a3 :> 'a6 | 'a7
//│     'a7 :> 'c | 'd
//│     'a6 :> 'c | 'd
//│     'm :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│        <: {num: 'num5}
//│     'rhs4 :> 'c | 'd
//│           <: 'rhs11
//│     'rhs11 :> 'c | 'd
//│            <: 'a1
//│     'o :> #Num & {num: 'num} | #Num & {num: 'num0} | #Num & {num: 'num1} | #Num & {num: 'num2}
//│        <: {num: 'num6}
//│     'num2 :> int
//│           <: 'num5 & 'num6 & 'num3 & 'num4 & int
//│     'num4 := int
//│     'num3 := int
//│     'num6 := int
//│     'num5 := int
//│     'num1 := int
//│     'lhs4 :> 'c | 'd
//│           <: 'lhs11
//│     'lhs11 :> 'c | 'd
//│            <: 'a1
//│     'rhs0 :> #Num & {num: 'num0}
//│           <: 'rhs1 & 'a1
//│     'rhs1 :> #Num & {num: 'num0} | 'c | 'd
//│           <: 'a1
//│     'name :> string
//│           <: 'name4 & 'name2 & string
//│     'name2 :> string
//│            <: 'p1
//│     'p1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     'name4 :> string
//│            <: 'u1
//│     'u1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     't1 :> string
//│     's1 :> string
//│         <: 'v1
//│     'v1 := string
//│     'r1 :> string
//│     'q1 :> string
//│         <: 'w1
//│     'w1 := string
//│     'a :> 'c | 'd
//│     'a1 :> #Num & {num: 'num0} | #Num & {num: 'num}
//│     'num :> 0
//│          <: int
//│     'num0 :> 0
//│           <: int
//│     'name0 :> string
//│            <: 'name1 & string
//│     'name1 := string
//│    = <no result>
//│      eval3, eval_lexpr, eval_lambda, eval_var, list_assoc and eq are not implemented

:ns
eval3 Nil (Abs { name = "s"; body = Add { lhs = Var { name = "s" }; rhs = Num { num = 1 } } })
//│ res: 'b
//│   where
//│     'b :> 'c | 'd
//│     'c :> 'e | 'f | 'g | 'h
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'h :> #Abs & {name: 'name, body: 'body, Abs#a = 'a}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'g :> #App & {lhs: 'lhs, rhs: 'rhs, App#a = 'a0}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'f :> 'c | 'd
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'e :> 'u | 'result
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'result :> 'c | 'd | #Var & {name: 'name0}
//│             <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'u :> #Var & {name: 'name1} | #Var & {name: 'name0}
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {name: 'name2}
//│     'i :> #Var & {name: 'name1} | #Abs & {Abs#a = 'a1, name: 'name3, body: 'body0} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: 'v
//│     'v :> #Var & {name: 'name1} | #Abs & {Abs#a = 'a1, name: 'name3, body: 'body0} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: #Var & 'w | (#App & 'x | #Abs & 'y & ~#App) & ~#Var
//│     'y :> #Abs & {Abs#a = 'a1, name: 'name3, body: 'body0} | #Abs & {Abs#a = 'a, name: 'name, body: 'body}
//│        <: {body: 'body1} & {name: 'name4}
//│     'x :> #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│        <: {rhs: 'rhs0} & {lhs: 'lhs0}
//│     'w :> #Var & {name: 'name1} | #Var & {name: 'name0}
//│        <: 'z
//│     'z :> #Var & {name: 'name1} | #Var & {name: 'name0}
//│        <: #Var & 'u
//│     'a1 :> #Add & {lhs: 'lhs1, rhs: 'rhs1, Add#a = 'a2}
//│     'lhs1 :> #Var & {name: 'name1}
//│           <: 'lhs2 & 'a2
//│     'lhs2 :> #Var & {name: 'name1} | 'c | 'd
//│           <: 'lhs3
//│     'lhs3 :> #Var & {name: 'name1} | 'c | 'd
//│           <: 'a1
//│     'd :> 'b1 | 'c1 | 'd1 | 'e1 | 'f1 | 'g1
//│        <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'e1 :> #Num & {num: 'num}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'c1 :> #Num & {num: 'num0}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'b1 :> 'h1 | 'result0
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'result0 :> 'c | 'd | #Var & {name: 'name0}
//│              <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'h1 <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {name: 'name5}
//│     'name5 <: string
//│     'k :> #Abs & {Abs#a = 'a, name: 'name, body: 'body}
//│        <: {body: 'body2} & {name: 'name6}
//│     'body :> 'c | 'd
//│           <: 'body1 & 'body2 & 'a
//│     'body2 :> 'c | 'd
//│            <: 'a1
//│     'body1 :> #Add & {lhs: 'lhs1, rhs: 'rhs1, Add#a = 'a2} | 'c | 'd
//│            <: 'a1
//│     'rhs1 :> #Num & {num: 'num1}
//│           <: 'rhs2 & 'a2
//│     'rhs2 :> #Num & {num: 'num1} | 'c | 'd
//│           <: 'rhs3
//│     'rhs3 :> #Num & {num: 'num1} | 'c | 'd
//│           <: 'a1
//│     'a1 :> #Var & {name: 'name1} | #Num & {num: 'num1} | #Add & {lhs: 'lhs1, rhs: 'rhs1, Add#a = 'a2} | #Abs & {name: 'name3, body: 'body0, Abs#a = 'a1} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0} | #Num & {num: 'num0} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | 'c | 'd
//│         <: #Lambda & 'i | #Expr & 'j & ~#Lambda
//│     'j :> #Num & {num: 'num1} | #Add & {Add#a = 'a2, lhs: 'lhs1, rhs: 'rhs1} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0}
//│        <: 'i1
//│     'i1 :> #Num & {num: 'num1} | #Add & {Add#a = 'a2, lhs: 'lhs1, rhs: 'rhs1} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0}
//│         <: #Var & 'j1 | (#Num & 'k1 | (#Add & 'l1 | #Mul & 'm1 & ~#Add) & ~#Num) & ~#Var
//│     'm1 :> #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5}
//│         <: {rhs: 'rhs6} & {lhs: 'lhs6}
//│     'l1 :> #Add & {Add#a = 'a2, lhs: 'lhs1, rhs: 'rhs1} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4}
//│         <: {rhs: 'rhs2} & {lhs: 'lhs2}
//│     'k1 :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│         <: #Var & 'n1 | (#Add & 'd1 | (#Mul & 'f1 | #Num & 'g1 & ~#Mul) & ~#Add) & ~#Var
//│     'j1 <: #Var & 'n1 | (#Add & 'd1 | (#Mul & 'f1 | #Num & 'g1 & ~#Mul) & ~#Add) & ~#Var
//│     'g1 :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'f1 :> #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs7} & {lhs: 'lhs7}
//│     'd1 :> #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4}
//│         <: anything & (#Abs & 'k | 'l & Object & ~#Abs) & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num) & {rhs: 'rhs8} & {lhs: 'lhs8}
//│     'l :> #Var & {name: 'name1} | #Num & {num: 'num1} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│        <: 'lhs
//│     'n1 <: 'o1
//│     'o1 <: #Var & 'h1
//│     'a0 :> #Var & {name: 'name1} | #Num & {num: 'num1} | 'c | 'd | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│     'lhs5 :> 'lhs9
//│           <: 'lhs6 & 'lhs7 & 'a4
//│     'lhs9 :> 'c | 'd
//│           <: 'lhs6 & 'lhs7 & 'a5
//│     'lhs7 :> 'c | 'd
//│           <: #Num & 'o | 'p & Object & ~#Num
//│     'p :> #Var & {name: 'name1} | #Var & {name: 'name0} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs5 :> 'rhs9
//│           <: 'rhs6 & 'rhs7 & 'a4
//│     'rhs9 :> 'c | 'd
//│           <: 'rhs6 & 'rhs7 & 'a6
//│     'rhs7 :> 'c | 'd
//│           <: #Num & 'm | 'n & Object & ~#Num
//│     'n :> #Var & {name: 'name1} | #Var & {name: 'name0} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs4 :> 'lhs10
//│           <: 'lhs2 & 'lhs8 & 'a3
//│     'lhs10 :> 'c | 'd
//│            <: 'lhs2 & 'lhs8 & 'a7
//│     'lhs8 :> 'c | 'd
//│           <: #Num & 's | 't & Object & ~#Num
//│     't :> #Var & {name: 'name1} | #Var & {name: 'name0} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'rhs4 :> 'rhs10
//│           <: 'rhs2 & 'rhs8 & 'a3
//│     'rhs10 :> 'c | 'd
//│            <: 'rhs2 & 'rhs8 & 'a8
//│     'rhs8 :> 'c | 'd
//│           <: #Num & 'q | 'r & Object & ~#Num
//│     'r :> #Var & {name: 'name1} | #Var & {name: 'name0} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Abs & {Abs#a = 'a, name: 'name, body: 'body} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│     'lhs :> #Var & {name: 'name1} | #Num & {num: 'num1} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs} | #Var & {name: 'name0}
//│          <: 'lhs0 & 'a0
//│     'lhs0 :> #Var & {name: 'name1} | #Num & {num: 'num1} | #Mul & {Mul#a = 'a4, lhs: 'lhs5, rhs: 'rhs5} | #Num & {num: 'num} | #Add & {Add#a = 'a3, lhs: 'lhs4, rhs: 'rhs4} | #Num & {num: 'num0} | #Var & {name: 'name0} | #App & {App#a = 'a0, lhs: 'lhs, rhs: 'rhs}
//│           <: 'a1
//│     'rhs :> 'c | 'd
//│          <: 'rhs0 & 'a0
//│     'rhs0 :> 'c | 'd
//│           <: 'a1
//│     'q :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num2}
//│     's :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num3}
//│     'a3 :> 'a7 | 'a8
//│     'a8 :> 'c | 'd
//│     'a7 :> 'c | 'd
//│     'm :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num4}
//│     'rhs6 :> 'c | 'd
//│           <: 'rhs11
//│     'rhs11 :> 'c | 'd
//│            <: 'a1
//│     'o :> #Num & {num: 'num1} | #Num & {num: 'num} | #Num & {num: 'num0}
//│        <: {num: 'num5}
//│     'num0 :> int
//│           <: 'num4 & 'num5 & 'num2 & 'num3 & int
//│     'num3 := int
//│     'num2 := int
//│     'num5 := int
//│     'num4 := int
//│     'num := int
//│     'lhs6 :> 'c | 'd
//│           <: 'lhs11
//│     'lhs11 :> 'c | 'd
//│            <: 'a1
//│     'a4 :> 'a5 | 'a6
//│     'a6 :> 'c | 'd
//│     'a5 :> 'c | 'd
//│     'body0 :> #Add & {lhs: 'lhs1, rhs: 'rhs1, Add#a = 'a2}
//│            <: 'body1 & 'a1
//│     'name3 :> "s"
//│            <: string
//│     'a2 :> #Num & {num: 'num1} | #Var & {name: 'name1}
//│     'num1 :> 1
//│           <: int
//│     'name :> string
//│           <: 'name6 & 'name4 & string
//│     'name4 :> string
//│            <: 'p1
//│     'p1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     'name6 :> string
//│            <: 'u1
//│     'u1 :> string
//│         <: 'q1 & 'r1 & 's1 & 't1
//│     't1 :> string
//│     's1 :> string
//│         <: 'v1
//│     'v1 := string
//│     'r1 :> string
//│     'q1 :> string
//│         <: 'w1
//│     'w1 := string
//│     'a :> 'c | 'd
//│     'name0 :> string
//│            <: 'name2 & string
//│     'name2 := string
//│     'name1 :> "s"
//│            <: string
//│    = <no result>
//│      eval3, eval_lexpr, eval_lambda, eval_var, list_assoc and eq are not implemented


// *************************************

def eval_lexpr' eval_rec subst v = case v of {
  | Var -> eval_var eval_rec subst v
  | Abs -> eval_lambda eval_rec subst v
  | App -> eval_lambda eval_rec subst v
  | Num -> eval_expr eval_rec subst v
  | Add -> eval_expr eval_rec subst v
  | Mul -> eval_expr eval_rec subst v
  }
//│ eval_lexpr': ((Cons[('a, Var | 'rhs,) | 'A] & {head: ('a, Var | 'rhs,), tail: Nil | 'tail} | 'tail) -> 'lhs -> ('rhs & 'result & (#Abs & {body: 'lhs, lhs: Num | Object & ~#Num, name: string & 'a, rhs: Num | Object & ~#Num} | 'lhs0 & (Num & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} | Object & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & ~#Abs & ~#Num))) & 'b) -> (Var & 'c -> ({lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & 'result) & 'd & List['A] & 'tail) -> (#Abs & {body: 'lhs, name: 'a} | #Add & {lhs: 'lhs, rhs: 'lhs} | #App & {lhs: 'lhs, rhs: 'lhs} | #Mul & {lhs: 'lhs, rhs: 'lhs} | #Num & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & 'result | #Var & 'c) -> (Abs['rhs] | Add[nothing] | App['rhs] & {lhs: 'lhs0, rhs: 'rhs} | Mul[nothing] | Num | 'result)
//│   where
//│     'd <: #Cons & {head: (string, {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & 'result,), tail: 'd} | Nil
//│     'b <: #Cons & {head: (string, 'c -> ({lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & 'result),), tail: 'b} | Nil
//│            = <no result>
//│              eval_var, list_assoc and eq are not implemented

