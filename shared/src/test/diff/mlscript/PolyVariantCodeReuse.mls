// ************************** Mix things *******************************

def eval_lexpr eval_rec subst v = case v of {
  | Lambda -> eval_lambda eval_rec subst v
  | Expr -> eval_expr eval_rec subst v
  }
//│ eval_lexpr: ((Cons[('a, Var | 'rhs,) | 'A] & {head: ('a, Var | 'rhs,), tail: Nil | 'tail} | 'tail) -> 'lhs -> ('result & 'rhs & (#Abs & {body: 'lhs, lhs: Num | Object & ~#Num, name: string & 'a, rhs: Num | Object & ~#Num} | 'lhs0 & (Num & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} | Object & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & ~#Abs & ~#Num)))) -> ('b & List['A] & 'tail) -> (#Abs & {body: 'lhs, name: 'a} | #Add & {lhs: 'lhs, rhs: 'lhs} | #App & {lhs: 'lhs, rhs: 'lhs} | #Mul & {lhs: 'lhs, rhs: 'lhs} | 'result & (#Num & {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} | Var & {lhs: Num | Object & ~#Num, rhs: Num | Object & ~#Num})) -> (Abs['rhs] | Add[nothing] | App['rhs] & {lhs: 'lhs0, rhs: 'rhs} | Mul[nothing] | Num | 'result)
//│   where
//│     'b <: #Cons & {head: (string, {lhs: Num | Object & ~#Num, name: string, rhs: Num | Object & ~#Num} & 'result,), tail: 'b} | Nil
//│           = <no result>
//│             eval_lambda, eval_var, list_assoc and eq are not implemented

:ns
rec def eval3 subst = eval_lexpr eval3 subst
