:ns
eval3 Nil (Abs { name = "s"; body = Var { name = "s" } })
//│ res: 'b
//│   where
//│     'b :> 'c | 'd
//│     'c :> 'e | 'f | 'g | 'h
//│        <: anything & (#Lambda & 'i | #Expr & 'j & ~#Lambda) & (#Abs & 'k | 'l & Object & ~#Abs) & (#Num & 'm | 'n & Object & ~#Num) & (#Num & 'o | 'p & Object & ~#Num) & (#Num & 'q | 'r & Object & ~#Num) & (#Num & 's | 't & Object & ~#Num)
//│     'h :> #Abs & {name: 'name, body: 'body, Abs#a = 'a}
