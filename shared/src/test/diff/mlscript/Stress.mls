:NoJS

class A[T]: { fA: T }
class B[T]: { fB: T }
class C[T]: { fC: T }
class D[T]: { fD: T }
class E[T]: { fE: T }
class F[T]: { fF: T }
class G[T]: { fG: T }
class H[T]: { fH: T }
//│ Defined class A[+T]
//│ Defined class B[+T]
//│ Defined class C[+T]
//│ Defined class D[+T]
//│ Defined class E[+T]
//│ Defined class F[+T]
//│ Defined class G[+T]
//│ Defined class H[+T]

:stats
def foo x = case x of {
  | A -> x.fA
  | B -> x.fB
  | C -> x.fC
  | D -> x.fD
  | E -> x.fE
  | F -> x.fF
  | G -> x.fG
  | H -> x.fH
  }
//│ foo: (#A & {fA: 'fA} | #B & {fB: 'fA} | #C & {fC: 'fA} | #D & {fD: 'fA} | #E & {fE: 'fA} | #F & {fF: 'fA} | #G & {fG: 'fA} | #H & {fH: 'fA}) -> 'fA
//│ constrain calls  : 26
//│ annoying  calls  : 0
//│ subtyping calls  : 802
//│ mkDeep calls     : 0


